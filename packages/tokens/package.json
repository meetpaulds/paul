{
  "name": "@meetpaul/tokens",
  "version": "1.2.0",
  "description": "Design tokens for the paul design system — CSS custom properties, Tailwind v4 preset, and typed JS token object.",
  "license": "MIT",
  "author": "SirPauls <office@sirpauls.com>",
  "homepage": "https://meetpaulds.github.io/paul",
  "repository": {
    "type": "git",
    "url": "https://github.com/meetpaulds/paul.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/meetpaulds/paul/issues"
  },
  "keywords": [
    "design-tokens",
    "css-variables",
    "tailwind",
    "design-system",
    "paul",
    "meetpaul",
    "dark-mode",
    "theming"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./tokens.css": "./dist/tokens.css",
    "./preset": {
      "import": "./dist/preset.js",
      "require": "./dist/preset.cjs",
      "types": "./dist/preset.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --declaration --outDir dist",
    "dev": "vite build --watch",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "recalculate:tokens": "tsx scripts/recalculate-tokens.ts --input=src/tokens.css --output=src/tokens.css",
    "recalculate:tokens:dry-run": "tsx scripts/recalculate-tokens.ts --dry-run --input=src/tokens.css --output=src/tokens.css",
    "validate:apca": "tsx scripts/validate-apca.ts",
    "validate:apca:json": "tsx scripts/validate-apca.ts --json=apca-report.json"
  },
  "devDependencies": {
    "apca-w3": "^0.1.9",
    "fast-check": "^4.7.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^5.4.14",
    "vitest": "^3.1.2"
  }
}
